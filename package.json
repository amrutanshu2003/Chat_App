{
  "name": "chat_app",
  "version": "1.0.0",
  "description": "Real-time chat application with video calling",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "dev": "npm run dev:server",
    "dev:server": "cd server && npm run dev",
    "build": "cd client && npm run build",
    "install:server": "cd server && npm install --legacy-peer-deps",
    "install:client": "cd client && npm install --legacy-peer-deps",
    "postinstall": "npm run install:server && npm run install:client",
    "install:all": "npm install --legacy-peer-deps && npm run postinstall"
  },
  "keywords": [
    "chat",
    "real-time",
    "video-calling",
    "react",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emoji-mart/react": "^1.1.1",
    "@simplewebauthn/server": "^13.1.1",
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "emoji-mart": "^5.6.0",
    "express": "^5.1.0",
    "i18next": "^25.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.10",
    "react-i18next": "^15.5.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
